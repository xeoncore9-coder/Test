{
  "name": "cat-tool",
  "version": "1.0.0",
  "description": "Computer-Assisted Translation tool",
  "scripts": {
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "mammoth": "^1.6.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0",
    "xml2js": "^0.6.2",
    "concurrently": "^8.2.2"
  }
}
